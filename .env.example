# VibeGraph environment variables (copy to .env and customize)

# Spring profile
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-local-only
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=100
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60s
NEO4J_MAX_CONNECTION_LIFETIME=1h

# Backend paths and limits
# Optional shared secret. When non-blank, the X-API-Key header is required on filesystem
# endpoints (import-local/import-archive/import-github, browse). Leave blank to disable (dev).
VIBEGRAPH_API_KEY=
VIBEGRAPH_PROJECTS_ALLOWED_ROOT=
VIBEGRAPH_UPLOAD_WORKSPACE=.vibegraph/uploads
VIBEGRAPH_IMPORT_ARCHIVE_MAX_SIZE=100MB
VIBEGRAPH_IMPORT_ARCHIVE_MAX_REQUEST_SIZE=105MB
VIBEGRAPH_PARSER_CACHE_DIR=.vibegraph/parse-cache

# Graph payload guardrails — cap the graph sent to BROWSER clients so a huge project
# cannot freeze the tab. Applied at BOTH browser-facing boundaries: the HTTP API
# (GET /api/projects/{id}/graph) and WebSocket FULL_UPDATE broadcasts. Internal Java
# consumers (diagram inference, MCP analyzers) still read the full graph directly.
# Defaults are the request caps; MAX_* are the hard ceilings for an explicit ?nodeLimit/?edgeLimit.
VIBEGRAPH_GRAPH_NODE_LIMIT=1500
VIBEGRAPH_GRAPH_EDGE_LIMIT=4000
VIBEGRAPH_GRAPH_MAX_NODE_LIMIT=10000
VIBEGRAPH_GRAPH_MAX_EDGE_LIMIT=30000

# Fail-fast ceilings for the in-memory analysis pipeline. Exceeding either marks the project
# FAILED instead of risking OutOfMemoryError. Raise if the host has the heap for larger projects.
VIBEGRAPH_ANALYZE_MAX_NODES=200000
VIBEGRAPH_ANALYZE_MAX_EDGES=600000

# File watcher
VIBEGRAPH_WATCHER_ENABLED=true
VIBEGRAPH_WATCHER_DEBOUNCE_MS=500

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080/ws/graph-updates
