# VibeGraph environment variables (copy to .env and customize)

# Spring profile
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Production host-proxy deployment: keep backend private on loopback.
# Local Docker development can override this with SERVER_BIND_ADDRESS=0.0.0.0.
SERVER_BIND_ADDRESS=127.0.0.1

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-local-only

# ── Control plane: PostgreSQL (auth / ownership) ──────────────────────────────
# Flyway owns the schema; JPA runs ddl-auto=validate. Local defaults match the
# docker-compose postgres service. Never commit real production secrets.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vibegraph
POSTGRES_USER=vibegraph
POSTGRES_PASSWORD=change-me-local-only

# Supabase realtime/event storage
# Keep disabled until the Supabase project is provisioned and existing rows are backfilled.
# Use the direct database connection when IPv6 is available. On an IPv4-only network,
# use the Supabase Session Pooler on port 5432. Do not use the transaction pooler (6543)
# for this persistent JDBC client. Session Pooler usernames are role.project-ref.
VIBEGRAPH_SUPABASE_ENABLED=false
# Runtime credential. In production this MUST be a least-privilege role with CRUD only on the
# vibegraph_realtime tables and no CREATE/ALTER/DROP. Do NOT use the postgres superuser here.
# Provision the role with scripts/supabase-runtime-role.sql.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=vibegraph_runtime.your-project-ref
SUPABASE_DB_PASSWORD=change-me-local-only
SUPABASE_DB_SCHEMA=vibegraph_realtime
# Set to true in production. Then the migration credential below becomes mandatory and startup
# fails if migration and runtime are the same role on the same database.
SUPABASE_REQUIRE_SEPARATE_CREDENTIALS=false
# Migration (DDL) credential: creates the schema and runs Flyway. Leave blank for local development
# to reuse the runtime credential; startup then logs a warning. Never leave blank in production.
SUPABASE_MIGRATION_DB_URL=jdbc:postgresql://aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_MIGRATION_DB_USER=postgres.your-project-ref
SUPABASE_MIGRATION_DB_PASSWORD=
SUPABASE_DB_MAX_POOL_SIZE=10
SUPABASE_DB_CONNECTION_TIMEOUT_MS=10000
SUPABASE_TELEMETRY_QUEUE_CAPACITY=10000
SUPABASE_TELEMETRY_BATCH_SIZE=250
SUPABASE_TELEMETRY_FLUSH_INTERVAL_MS=2000
# Failed telemetry batches keep their identity and retry with exponential backoff.
# Telemetry is best-effort: batches are held in memory only.
SUPABASE_TELEMETRY_RETRY_QUEUE_CAPACITY=200
SUPABASE_TELEMETRY_MAX_ATTEMPTS=4
SUPABASE_TELEMETRY_RETRY_BACKOFF_MS=1000
SUPABASE_TELEMETRY_MAX_RETRY_BACKOFF_MS=60000
SUPABASE_TELEMETRY_RETRY_BATCHES_PER_CYCLE=2
# Drain throughput ceiling = SUPABASE_TELEMETRY_BATCH_SIZE x this value per flush cycle.
# Leave at 1 until the capacity policy has a measured peak arrival rate.
SUPABASE_TELEMETRY_FRESH_BATCHES_PER_CYCLE=1
SUPABASE_TELEMETRY_MAX_SPLIT_DEPTH=4
# Keep the container termination grace period LONGER than this drain budget.
SUPABASE_TELEMETRY_SHUTDOWN_DRAIN_TIMEOUT_MS=10000
SUPABASE_TELEMETRY_SHUTDOWN_RETRY_PAUSE_MS=250
SUPABASE_RETENTION_REQUEST_EVENT_DAYS=14
SUPABASE_RETENTION_SECURITY_EVENT_DAYS=180
SUPABASE_RETENTION_DISMISSED_NOTIFICATION_DAYS=90
SUPABASE_RETENTION_EXPIRED_ANNOUNCEMENT_DAYS=180

# ── Auth: JWT (HS512) ─────────────────────────────────────────────────────────
# JWT_SECRET MUST be >=64 UTF-8 bytes; the app fails fast at startup otherwise.
JWT_SECRET=change-me-local-only-min-64-characters-for-hs512-signing-secret
# Dedicated AES-256 key for API-key secrets (Base64 of exactly 32 random bytes).
# Generate with: openssl rand -base64 32
API_KEY_ENCRYPTION_KEY_CURRENT=
# Keep the prior Base64 key here during a rotation overlap window, then remove it after rewrap.
API_KEY_ENCRYPTION_KEY_PREVIOUS=
# Set the previous JWT secret only while legacy (unversioned) ciphertext is being migrated.
API_KEY_ENCRYPTION_LEGACY_SECRET=
# Production policy: access JWT 30 minutes, absolute rotating refresh session 7 days.
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000
# Defaults to true in application.yaml. Set false ONLY for local plain-HTTP development reached
# over something other than localhost (browsers already accept Secure cookies on localhost).
# Never set false in production: it would send session cookies over plaintext.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# OAuth login (Google / GitHub)
# FRONTEND_URL is where OAuth returns after success/failure.
# OAUTH_REDIRECT_BASE_URL is the public backend base URL used in provider callback registration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
# Production with the frontend and API on separate public origins:
# FRONTEND_URL=https://vibegraph.tech
# OAUTH_REDIRECT_BASE_URL=https://api.vibegraph.tech
# Register these exact provider callback URLs:
# Google: https://api.vibegraph.tech/login/oauth2/code/google
# GitHub: https://api.vibegraph.tech/login/oauth2/code/github
OAUTH_SUCCESS_PATH=/
OAUTH_LOGIN_PATH=/login

# CLI browser authorization
# Optional override. Local Vite inherits FRONTEND_URL (5173); Docker Compose defaults this to 3000.
# VIBEGRAPH_CLI_DEVICE_FRONTEND_URL=http://localhost:3000
# Production: VIBEGRAPH_CLI_DEVICE_FRONTEND_URL=https://vibegraph.tech
VIBEGRAPH_CLI_DEVICE_TTL_SECONDS=600
VIBEGRAPH_CLI_DEVICE_POLL_INTERVAL_SECONDS=2
VIBEGRAPH_CLI_DEVICE_CLEANUP_CRON=0 20 3 * * ?

# MCP orchestration task retention
VIBEGRAPH_MCP_TASK_RETENTION_ENABLED=true
VIBEGRAPH_MCP_TASK_RETENTION_DAYS=90
VIBEGRAPH_MCP_TASK_RETENTION_BATCH_SIZE=500
VIBEGRAPH_MCP_TASK_RETENTION_MAX_BATCHES=20
VIBEGRAPH_MCP_TASK_RETENTION_CRON=0 15 3 * * ?

# ── Admin bootstrap (explicit, opt-in) ────────────────────────────────────────
# Disabled by default: normal startup NEVER creates an admin. Set ENABLED=true only for a
# deliberate one-shot admin bootstrap; it then requires ADMIN_EMAIL and one of
# ADMIN_PASSWORD / ADMIN_PASSWORD_HASH, or the app fails fast at startup.
VIBEGRAPH_AUTH_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# ── Realtime demo permit (/ws, /mcp) ──────────────────────────────────────────
# Default false = fail closed (those routes require auth). Setting true permits them
# for demo/local only, is documented, and logs a startup WARNING. Not multi-user safe.
VIBEGRAPH_REALTIME_DEMO_PERMIT=false
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=100
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60s
NEO4J_MAX_CONNECTION_LIFETIME=1h

# Backend paths and limits
VIBEGRAPH_PROJECTS_ALLOWED_ROOT=
# Path to the AI memory / conventions file surfaced by the MCP conventions tool
VIBEGRAPH_AI_MEMORY_PATH=VibeGraph-specs-2month/ai-memory.md
VIBEGRAPH_UPLOAD_WORKSPACE=.vibegraph/uploads
# Account plans enforce the effective quota. These are host-level safety ceilings.
VIBEGRAPH_IMPORT_ARCHIVE_HARD_MAX_SIZE=2048MB
VIBEGRAPH_IMPORT_ARCHIVE_HARD_MAX_REQUEST_SIZE=2050MB
VIBEGRAPH_PARSER_CACHE_DIR=.vibegraph/parse-cache
# parse cache on/off (re-parsing every file is slower but always fresh)
VIBEGRAPH_PARSER_USE_CACHE=true
# Phase 3 deep CPG: LocalVariable nodes + READS/WRITES/CATCHES edges. OFF by default
# (body-level data-flow can multiply node/edge counts; opt-in for deep analysis).
VIBEGRAPH_PARSER_DEEP_CPG=false

# Graph payload guardrails — cap the graph sent to BROWSER clients so a huge project
# cannot freeze the tab. Applied at BOTH browser-facing boundaries: the HTTP API
# (GET /api/projects/{id}/graph) and WebSocket FULL_UPDATE broadcasts. Internal Java
# consumers (diagram inference, MCP analyzers) still read the full graph directly.
# Defaults are the request caps; MAX_* are the hard ceilings for an explicit ?nodeLimit/?edgeLimit.
VIBEGRAPH_GRAPH_NODE_LIMIT=2500
VIBEGRAPH_GRAPH_EDGE_LIMIT=6000
VIBEGRAPH_GRAPH_MAX_NODE_LIMIT=10000
VIBEGRAPH_GRAPH_MAX_EDGE_LIMIT=30000

# Fail-fast ceilings for the in-memory analysis pipeline. Exceeding either marks the project
# FAILED instead of risking OutOfMemoryError. Raise if the host has the heap for larger projects.
VIBEGRAPH_ANALYZE_MAX_NODES=200000
VIBEGRAPH_ANALYZE_MAX_EDGES=600000

# GitHub import HTTP timeouts and bounded retry policy (Spring Duration syntax: 500ms, 1s, 1m)
VIBEGRAPH_GITHUB_CONNECT_TIMEOUT=15s
VIBEGRAPH_GITHUB_PREFLIGHT_TIMEOUT=20s
VIBEGRAPH_GITHUB_TARBALL_TIMEOUT=60s
VIBEGRAPH_GITHUB_MAX_ATTEMPTS=3
VIBEGRAPH_GITHUB_RETRY_INITIAL_DELAY=1s

# Async analysis executor (bounded thread pool)
VIBEGRAPH_ANALYSIS_CORE_POOL_SIZE=2
VIBEGRAPH_ANALYSIS_MAX_POOL_SIZE=4
VIBEGRAPH_ANALYSIS_QUEUE_CAPACITY=50
VIBEGRAPH_ANALYSIS_THREAD_PREFIX=analysis-

# Anti-abuse defaults
VIBEGRAPH_CONCURRENT_IMPORTS_PER_USER=1
VIBEGRAPH_REQUESTS_PER_MINUTE_PER_IP=120
VIBEGRAPH_REQUESTS_PER_MINUTE_PER_USER=240
VIBEGRAPH_REQUESTS_PER_MINUTE_PER_API_KEY=240
# Local/direct backend: keep false. Production behind the host reverse proxy: true.
VIBEGRAPH_TRUST_PROXY=false
# This is the proxy peer address visible to the backend, not the end-user IP.
# With a host Caddy/Nginx proxy and a Docker-published backend, Linux commonly
# exposes the proxy peer as the Compose network gateway (for example 172.18.0.1).
# If the proxy runs in a container, use its static container IP or the smallest
# proxy-only CIDR (for example 172.18.0.0/28). Confirm the peer on the deployment
# host after every network change. Never use 0.0.0.0/0.
VIBEGRAPH_TRUSTED_PROXIES=127.0.0.1
# Per-instance rate-limit window store bounds. Rate limiting is NOT cluster-wide: each replica
# tracks its own windows, so N replicas allow up to N times the configured rate.
VIBEGRAPH_RATE_LIMIT_WINDOW_MAX_SIZE=100000
VIBEGRAPH_RATE_LIMIT_WINDOW_TTL_MS=180000

# File watcher
VIBEGRAPH_WATCHER_ENABLED=true
VIBEGRAPH_WATCHER_DEBOUNCE_MS=500

# Frontend / CORS
# FRONTEND_URL is declared once in the OAuth/CLI browser authorization section above.
VITE_API_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080/ws/graph-updates
# Extra origins allowed in the frontend CSP connect-src. Defaults to VITE_API_URL
# plus VITE_WS_URL, which is right when the API is on its own origin. Set it
# explicitly if the app must also reach somewhere else; leave it alone otherwise.
# Getting this wrong shows up as every API call blocked in the browser console.
# CSP_CONNECT_SRC=https://api.example.com wss://api.example.com

# Frontend tuning (VITE_*) — baked in at build time; restart `vite dev` or rebuild after changing.
# All values are optional; the app falls back to the documented default when blank/omitted.

# Graph rendering
# max nodes rendered before Safe Mode caps the view (B-M10: keep > 0; 0 disables Safe Mode)
VITE_GRAPH_SAFE_NODE_LIMIT=3000
# max neighbors merged when expanding a single node
VITE_EXPAND_MAX_NEIGHBORS=500
# rendered node radius: default / min / max
VITE_NODE_SIZE_DEFAULT=9
VITE_NODE_SIZE_MIN=6
VITE_NODE_SIZE_MAX=26
# per-tier node radius (Project > Package > File > Type > Member/Endpoint)
VITE_NODE_SIZE_PROJECT=18
VITE_NODE_SIZE_PACKAGE=14
VITE_NODE_SIZE_FILE=11
VITE_NODE_SIZE_TYPE=10
VITE_NODE_SIZE_MEMBER=8
VITE_NODE_SIZE_ENDPOINT=8
# focus-mode opacity (0–1): active node / dimmed node
VITE_FOCUS_OPACITY_ACTIVE=1.0
VITE_FOCUS_OPACITY_DIMMED=0.1

# Import / analysis polling
# how often import flows poll project status (ms)
VITE_IMPORT_POLL_INTERVAL_MS=1000
# give up only after this long with NO progress — a genuine stall (ms)
VITE_IMPORT_STALL_TIMEOUT_MS=300000
# absolute ceiling so polling can't run forever (ms)
VITE_IMPORT_ABSOLUTE_TIMEOUT_MS=3600000

# WebSocket (STOMP/SockJS)
# reconnect delay after a dropped socket (ms)
VITE_WS_RECONNECT_DELAY_MS=5000
# inbound / outbound STOMP heartbeat (ms)
VITE_WS_HEARTBEAT_INCOMING_MS=10000
VITE_WS_HEARTBEAT_OUTGOING_MS=10000

# Sigma labels (zoom-responsive sizing)
# base node / edge label size at ratio=1 zoom
VITE_SIGMA_BASE_NODE_LABEL_SIZE=7
VITE_SIGMA_BASE_EDGE_LABEL_SIZE=8
# node label zoom-scale floor / cap
VITE_SIGMA_MIN_LABEL_ZOOM_SCALE=0.5
VITE_SIGMA_MAX_LABEL_ZOOM_SCALE=2.25
# edge label zoom-scale floor / cap. Edge labels hold a fixed size across the normal
# zoom range and only enlarge past SIGMA_EDGE_LABEL_GROW_ZOOM, up to this cap
VITE_SIGMA_MIN_EDGE_LABEL_ZOOM_SCALE=1
VITE_SIGMA_MAX_EDGE_LABEL_ZOOM_SCALE=5
# min on-screen node size before its label is drawn (lower = names show sooner)
VITE_SIGMA_LABEL_RENDERED_SIZE_THRESHOLD=8
# zoom-in factor (fit view = 1x) past which NODE labels start growing; below it labels
# keep a constant on-screen size while panning/casual zoom
VITE_SIGMA_LABEL_GROW_ZOOM=1.5
# zoom-in factor past which EDGE type labels start growing. Kept high so edge labels
# stay a fixed size across normal zoom and only enlarge on deep zoom (10 = grow past 10x)
VITE_SIGMA_EDGE_LABEL_GROW_ZOOM=12
# rendered edge thickness. SIGMA_EDGE_SIZE is tiny so the min-thickness floor rules,
# pinning lines to a constant thin width at every zoom (no ballooning on deep zoom)
VITE_SIGMA_EDGE_SIZE=0.25
VITE_SIGMA_MIN_EDGE_THICKNESS=2.8

# label-reveal zoom thresholds (Sigma ratio: LOWER = zoomed IN). Above MINIMAL only
# a forced/selected label shows; between EDGE and MINIMAL node labels reveal; at or
# below EDGE edge type labels appear. EDGE is kept deep so edge labels force on only
# when few edges remain on screen (smooth + viewport-culled)
VITE_SIGMA_MINIMAL_LABEL_RATIO=1.05
VITE_SIGMA_EDGE_LABEL_RATIO=0.45

# max edge type labels drawn per frame (off-screen ones are culled for free and
# don't count). Caps the visible ones so a zoom level with many edges can't stack
# hundreds of rotated text draws into one frame. Lower = smoother, fewer at once
VITE_SIGMA_MAX_EDGE_LABELS_PER_FRAME=48

# zoom-to-fit camera animation duration (ms)
VITE_ZOOM_FIT_DURATION_MS=300

# Node detail panel
# max properties / connections (per direction) shown
VITE_NODE_DETAIL_MAX_PROPERTIES=12
VITE_NODE_DETAIL_MAX_CONNECTIONS=50

# Search
# max suggestions shown in the graph search bar
VITE_SEARCH_SUGGESTIONS_LIMIT=8

# UML use-case diagram
# label truncation length (chars) before ellipsis
VITE_UML_USECASE_MAX_CHARS=28
VITE_UML_ACTOR_MAX_CHARS=18

# Tier 2 LLM use-case label refinement (Gemini Developer API, key-based). OFF by default.
# Enable: set GEMINI_API_KEY, SPRING_AI_MODEL_CHAT=google-genai, VIBEGRAPH_USECASE_LLM_ENABLED=true.
# The LLM may ONLY relabel existing use cases (grounded to real ids); never adds/removes nodes/edges.
GEMINI_API_KEY=
SPRING_AI_MODEL_CHAT=none
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
VIBEGRAPH_USECASE_LLM_ENABLED=false

# ── Tier 2 — Failover Matrix (xoay API KEY × xoay MODEL) ──
# GEMINI_API_KEYS: danh sách key ngăn cách dấu phẩy (mỗi key = 1 project Google AI Studio free).
#   Cạn 1 key (429 trên cả chuỗi model) -> tự sang key kế tiếp. Trống -> fallback GEMINI_API_KEY.
GEMINI_API_KEYS=
GEMINI_ROTATION_TIMEOUT_MS=12000
# Chuỗi model ưu tiên thử trên MỖI key (model4 nên là model hạn mức cao nhất).
GEMINI_MODEL_1=gemini-3.5-flash
GEMINI_MODEL_2=gemini-3-flash
GEMINI_MODEL_3=gemini-2.5-flash
GEMINI_MODEL_4=gemini-3.1-flash-lite
