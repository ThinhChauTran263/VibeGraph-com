# VibeGraph environment variables (copy to .env and customize)

# Spring profile
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-local-only
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=100
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60s
NEO4J_MAX_CONNECTION_LIFETIME=1h

# Backend paths and limits
VIBEGRAPH_PROJECTS_ALLOWED_ROOT=
# Path to the AI memory / conventions file surfaced by the MCP conventions tool
VIBEGRAPH_AI_MEMORY_PATH=VibeGraph-specs-2month/ai-memory.md
VIBEGRAPH_UPLOAD_WORKSPACE=.vibegraph/uploads
VIBEGRAPH_IMPORT_ARCHIVE_MAX_SIZE=100MB
VIBEGRAPH_IMPORT_ARCHIVE_MAX_REQUEST_SIZE=105MB
VIBEGRAPH_PARSER_CACHE_DIR=.vibegraph/parse-cache
# parse cache on/off (re-parsing every file is slower but always fresh)
VIBEGRAPH_PARSER_USE_CACHE=true
# Phase 3 deep CPG: LocalVariable nodes + READS/WRITES/CATCHES edges. OFF by default
# (body-level data-flow can multiply node/edge counts; opt-in for deep analysis).
VIBEGRAPH_PARSER_DEEP_CPG=false

# Graph payload guardrails — cap the graph sent to BROWSER clients so a huge project
# cannot freeze the tab. Applied at BOTH browser-facing boundaries: the HTTP API
# (GET /api/projects/{id}/graph) and WebSocket FULL_UPDATE broadcasts. Internal Java
# consumers (diagram inference, MCP analyzers) still read the full graph directly.
# Defaults are the request caps; MAX_* are the hard ceilings for an explicit ?nodeLimit/?edgeLimit.
VIBEGRAPH_GRAPH_NODE_LIMIT=1500
VIBEGRAPH_GRAPH_EDGE_LIMIT=4000
VIBEGRAPH_GRAPH_MAX_NODE_LIMIT=10000
VIBEGRAPH_GRAPH_MAX_EDGE_LIMIT=30000

# Fail-fast ceilings for the in-memory analysis pipeline. Exceeding either marks the project
# FAILED instead of risking OutOfMemoryError. Raise if the host has the heap for larger projects.
VIBEGRAPH_ANALYZE_MAX_NODES=200000
VIBEGRAPH_ANALYZE_MAX_EDGES=600000

# GitHub import HTTP timeouts (Spring Duration syntax, e.g. 10s, 500ms, 1m)
VIBEGRAPH_GITHUB_CONNECT_TIMEOUT=10s
VIBEGRAPH_GITHUB_PREFLIGHT_TIMEOUT=20s
VIBEGRAPH_GITHUB_TARBALL_TIMEOUT=60s

# Async analysis executor (bounded thread pool)
VIBEGRAPH_ANALYSIS_CORE_POOL_SIZE=2
VIBEGRAPH_ANALYSIS_MAX_POOL_SIZE=4
VIBEGRAPH_ANALYSIS_QUEUE_CAPACITY=50
VIBEGRAPH_ANALYSIS_THREAD_PREFIX=analysis-

# File watcher
VIBEGRAPH_WATCHER_ENABLED=true
VIBEGRAPH_WATCHER_DEBOUNCE_MS=500

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080/ws/graph-updates

# Frontend tuning (VITE_*) — baked in at build time; restart `vite dev` or rebuild after changing.
# All values are optional; the app falls back to the documented default when blank/omitted.

# Graph rendering
# max nodes rendered before Safe Mode caps the view
VITE_GRAPH_SAFE_NODE_LIMIT=1500
# max neighbors merged when expanding a single node
VITE_EXPAND_MAX_NEIGHBORS=500
# rendered node radius: default / min / max
VITE_NODE_SIZE_DEFAULT=5
VITE_NODE_SIZE_MIN=3
VITE_NODE_SIZE_MAX=20
# focus-mode opacity (0–1): active node / dimmed node
VITE_FOCUS_OPACITY_ACTIVE=1.0
VITE_FOCUS_OPACITY_DIMMED=0.1

# Import / analysis polling
# how often import flows poll project status (ms)
VITE_IMPORT_POLL_INTERVAL_MS=1000
# give up only after this long with NO progress — a genuine stall (ms)
VITE_IMPORT_STALL_TIMEOUT_MS=300000
# absolute ceiling so polling can't run forever (ms)
VITE_IMPORT_ABSOLUTE_TIMEOUT_MS=3600000

# Project list
# background refresh cadence for "Your projects" (ms)
VITE_PROJECTS_AUTO_REFRESH_INTERVAL_MS=5000

# Archive upload
# client-side max archive size in MB (backend re-validates)
VITE_ARCHIVE_MAX_SIZE_MB=100

# WebSocket (STOMP/SockJS)
# reconnect delay after a dropped socket (ms)
VITE_WS_RECONNECT_DELAY_MS=5000
# inbound / outbound STOMP heartbeat (ms)
VITE_WS_HEARTBEAT_INCOMING_MS=10000
VITE_WS_HEARTBEAT_OUTGOING_MS=10000

# Sigma labels (zoom-responsive sizing)
# base node / edge label size at ratio=1 zoom
VITE_SIGMA_BASE_NODE_LABEL_SIZE=8
VITE_SIGMA_BASE_EDGE_LABEL_SIZE=3
# node label zoom-scale floor / cap
VITE_SIGMA_MIN_LABEL_ZOOM_SCALE=0.5
VITE_SIGMA_MAX_LABEL_ZOOM_SCALE=2.25
# edge label zoom-scale floor / cap
VITE_SIGMA_MIN_EDGE_LABEL_ZOOM_SCALE=1
VITE_SIGMA_MAX_EDGE_LABEL_ZOOM_SCALE=4
# min on-screen node size before its label is drawn
VITE_SIGMA_LABEL_RENDERED_SIZE_THRESHOLD=15

# ForceAtlas2 layout
VITE_FA2_GRAVITY=1
VITE_FA2_SCALING_RATIO=10
# enable Barnes-Hut optimization once node count exceeds this
VITE_FA2_BARNES_HUT_MIN_NODES=500
VITE_FA2_SLOW_DOWN=5
# auto-stop the layout worker after this long (ms)
VITE_LAYOUT_AUTO_STOP_MS=5000
# zoom-to-fit camera animation duration (ms)
VITE_ZOOM_FIT_DURATION_MS=300

# Node detail panel
# max properties / connections (per direction) shown
VITE_NODE_DETAIL_MAX_PROPERTIES=12
VITE_NODE_DETAIL_MAX_CONNECTIONS=50

# Search
# max suggestions shown in the graph search bar
VITE_SEARCH_SUGGESTIONS_LIMIT=8

# UML use-case diagram
# label truncation length (chars) before ellipsis
VITE_UML_USECASE_MAX_CHARS=28
VITE_UML_ACTOR_MAX_CHARS=18

# Tier 2 LLM use-case label refinement (Gemini Developer API, key-based). OFF by default.
# Enable: set GEMINI_API_KEY, SPRING_AI_MODEL_CHAT=google-genai, VIBEGRAPH_USECASE_LLM_ENABLED=true.
# The LLM may ONLY relabel existing use cases (grounded to real ids); never adds/removes nodes/edges.
GEMINI_API_KEY=
SPRING_AI_MODEL_CHAT=none
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
VIBEGRAPH_USECASE_LLM_ENABLED=false

# ── Tier 2 — Failover Matrix (xoay API KEY × xoay MODEL) ──
# GEMINI_API_KEYS: danh sách key ngăn cách dấu phẩy (mỗi key = 1 project Google AI Studio free).
#   Cạn 1 key (429 trên cả chuỗi model) -> tự sang key kế tiếp. Trống -> fallback GEMINI_API_KEY.
GEMINI_API_KEYS=
GEMINI_ROTATION_TIMEOUT_MS=12000
# Chuỗi model ưu tiên thử trên MỖI key (model4 nên là model hạn mức cao nhất).
GEMINI_MODEL_1=gemini-3.5-flash
GEMINI_MODEL_2=gemini-3-flash
GEMINI_MODEL_3=gemini-2.5-flash
GEMINI_MODEL_4=gemini-3.1-flash-lite
